<?xml version="1.0" encoding="ISO-8859-1" ?>
<metadados xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="../.gradle/metadados.xsd">

    <table name="DRQ_LOG" sequenceType="A" sequenceField="ID_LOG">
        <description>Log de Requisições</description>
        <primaryKey>
            <field name="ID_LOG"/>
        </primaryKey>
        <instances>
            <instance name="DRQ_Log">
                <description>Instância de Log Requisições</description>
                <relationShip>
                    <relation entityName="DRQ_UsuarioAlteracao">
                        <fields>
                            <field localName="USUARIO_ATUALIZACAO" targetName="CODUSU"/>
                        </fields>
                    </relation>
                    <relation entityName="DRQ_Requisicao">
                        <fields>
                            <field localName="ID_REQ" targetName="ID_REQ"/>
                        </fields>
                    </relation>
                </relationShip>
            </instance>
        </instances>
        <fields>
            <field order="0" name="ID_LOG" dataType="INTEIRO" allowSearch="S" visibleOnSearch="S">
                <description>ID do Log</description>
            </field>
            <field order="1" name="USUARIO_ATUALIZACAO" dataType="INTEIRO" allowSearch="N" visibleOnSearch="S"
                   readOnly="S">
                <description>Usuário de Atualização</description>
                <expression><![CDATA[return $ctx_usuario_logado]]></expression>
            </field>
            <field order="2" name="DT_ATUALIZACAO" dataType="DATA_HORA" allowSearch="N" visibleOnSearch="S"
                   readOnly="S">
                <description>Data de Atualização</description>
                <expression><![CDATA[return $ctx_dh_atual;]]></expression>
            </field>
            <field order="3" name="DETALHE" dataType="CAIXA_TEXTO" allowSearch="S" visibleOnSearch="S" readOnly="S">
                <description>Detalhes</description>
            </field>
            <field order="4" name="ID_REQ" dataType="INTEIRO" allowSearch="S" visibleOnSearch="S" readOnly="S">
                <description>ID da Requisição</description>
            </field>
        </fields>
    </table>


</metadados>
